# Variable de entorno de Lisboa360 Backend
# Instalar dependencias: pip install -r requirements.txt
# Ejecutar: python app.py  (o: FLASK_ENV=development python -m app)

# Entorno de ejecución
FLASK_ENV=development
FLASK_DEBUG=1
SERVER_HOST=127.0.0.1
SERVER_PORT=5000

# Base de datos SQLite (directorio database/ creado automáticamente)
DATABASE_PATH=./database/lisboa360.db

# Orígenes permitidos (CORS, frontend lisboa360-frontend)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8000,http://localhost:8000

# Semilla de datos ficticios de desarrollo (1 activa, 0 desactiva)
SEED_FICTICIO=1
